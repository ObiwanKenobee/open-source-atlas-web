{
  "name": "atlas-sanctum-prototype",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "seed": "npm -w server run seed",
    "test": "npm -w server run test",
    "typecheck": "npm -w server run typecheck && npm -w web run typecheck",
    "build": "npm -w web run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
